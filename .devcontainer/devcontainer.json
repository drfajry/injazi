{
"name": "Injazi Development",
"build": {
"dockerfile": "Dockerfile"
},
"features": {
"ghcr.io/devcontainers/features/node:1": {
"version": "24"
},
"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
"moby": true,
"installDockerBuildx": true,
"dockerDashComposeVersion": "v2"
}
},
"forwardPorts": [4000],
"customizations": {
"vscode": {
"extensions": [
"Dart-Code.flutter",
"Dart-Code.dart-code"
]
}
},
"postCreateCommand": "cd injazi-backend && npm install && npx prisma generate && cd ../injazi-flutter && flutter pub get"
}
